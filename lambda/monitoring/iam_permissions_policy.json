{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadMonitoringData",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::riskrate-auto-pricing-data/monitoring/*"
    },
    {
      "Sid": "PublishMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*"
    }
  ]
}
